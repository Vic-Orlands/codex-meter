class UsageRail(Gtk.Box):
    def __init__(self, title):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        row = Gtk.Box()
        row.pack_start(Gtk.Label(label=title, xalign=0), True, True, 0)
        self.value = Gtk.Label(label="—", xalign=1)
        row.pack_end(self.value, False, False, 0)
        self.pack_start(row, False, False, 0)
        self.bar = Gtk.ProgressBar()
        self.pack_start(self.bar, False, False, 0)
        self.detail = Gtk.Label(label="", xalign=1)
        self.detail.get_style_context().add_class("dim-label")
        self.pack_start(self.detail, False, False, 0)

    def update(self, percent, detail=""):
        self.bar.set_fraction(max(0, min(100, percent or 0)) / 100)
        self.value.set_text("—" if percent is None else f"{round(percent)}% used")
        self.detail.set_text(detail)


class ActivityGrid(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.values = [0] * 112
        self.set_size_request(-1, 78)
        self.connect("draw", self._draw)

    def update(self, buckets):
        values = {
            item.get("startDate", "")[:10]: number(item.get("tokens"))
            for item in buckets
        }
        today = datetime.now().date()
        self.values = [
            values.get((today - timedelta(days=111 - index)).isoformat(), 0)
            for index in range(112)
        ]
        self.queue_draw()

    def _draw(self, _widget, context):
        width = self.get_allocated_width()
        gap, cell = 3, max(3, (width - 15 * 3) / 16)
        maximum = max(self.values or [1])
        for index, value in enumerate(self.values):
            column, row = divmod(index, 7)
            intensity = value / maximum if maximum else 0
            color = (
                (0.22, 0.78, 0.67, 0.30 + intensity * 0.70)
                if value else (0.32, 0.32, 0.34, 0.45)
            )
            context.set_source_rgba(*color)
            context.rectangle(column * (cell + gap), row * 11, cell, 8)
            context.fill()


def stat(title):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    label = Gtk.Label(label=title, xalign=0)
    label.get_style_context().add_class("dim-label")
    value = Gtk.Label(label="—", xalign=0)
    value.set_ellipsize(Pango.EllipsizeMode.END)
    box.pack_start(label, False, False, 0)
    box.pack_start(value, False, False, 0)
    return box, value


