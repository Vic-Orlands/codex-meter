    def load_accounts(self, profiles, selected_id):
        self.account_combo.handler_block_by_func(self.app.account_selected)
        self.account_combo.remove_all()
        selected_index = 0
        for index, profile in enumerate(profiles):
            self.account_combo.append(profile["id"], profile["name"])
            if profile["id"] == selected_id:
                selected_index = index
        if profiles:
            self.account_combo.set_active(selected_index)
        self.account_combo.handler_unblock_by_func(self.app.account_selected)

    def update_codex(self, profile, data, active):
        account = data.get("account") or {}
        limits = data.get("rateLimits") or {}
        usage = data.get("usage") or {}
        self.codex_name.set_text(profile["name"])
        self.codex_email.set_text(account.get("email") or "Waiting for account details")
        self.codex_plan.set_text(
            (account.get("planType") or limits.get("planType") or "").upper()
        )
        self.codex_error.set_text("")
        for rail, window in (
            (self.primary, limits.get("primary")),
            (self.secondary, limits.get("secondary")),
        ):
            rail.update(None if not window else number(window.get("usedPercent")), reset_text(window))
        credits = limits.get("credits") or {}
        credit_text = (
            "Unlimited" if credits.get("unlimited")
            else str(credits.get("balance") or (
                "Available" if credits.get("hasCredits") else "None"
            ))
        )
        self.credits.set_text(credit_text)
        self.lifetime.set_text(compact(usage.get("lifetimeTokens")))
        streak = usage.get("currentStreakDays")
        self.streak.set_text(f"{number(streak)}d" if streak is not None else "—")
        self.codex_activity.update(data.get("dailyUsage") or [])
        self.use_account.set_visible(not active)
        self.updated.set_text("Updated " + datetime.now().strftime("%H:%M"))

    def update_cursor(self, data):
        self.cursor_email.set_text(data.get("email") or "Cursor account")
        self.cursor_plan.set_text(
            (data.get("membershipType") or "").replace("_", " ").upper()
        )
        self.cursor_error.set_text("")
        self.auto_rail.update(data.get("autoPercentUsed"))
        self.models_rail.update(data.get("apiPercentUsed"))
        self.included.set_text(
            f"{money(data.get('planUsedCents'))} of {money(data.get('planLimitCents'))}"
        )
        self.cursor_tokens.set_text(compact(data.get("totalTokens")))
        self.on_demand.set_text(money(data.get("onDemandUsedCents")))
        self.plan_left.set_text(f"{round(100 - (data.get('planPercentUsed') or 0))}%")
        self.cursor_activity.update(data.get("dailyUsage") or [])
        self.updated.set_text("Updated " + datetime.now().strftime("%H:%M"))

    def _hide(self, *_args):
        self.hide()
        return True


class CodexMeterApplication:
    def __init__(self):
        self.store = AccountStore()
        self.selected_id = self.store.active_id or (
            self.store.profiles[0]["id"] if self.store.profiles else None
        )
        self.snapshots = {}
        self.refreshing = False
        self.window = MeterWindow(self)
        self.window.load_accounts(self.store.profiles, self.selected_id)
        self.indicator = AppIndicator.Indicator.new(
            APP_ID, "codex-meter", AppIndicator.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("Codex Meter")
        self.menu = Gtk.Menu()
        self.summary_item = Gtk.MenuItem(label="Codex Meter · Loading…")
        self.summary_item.set_sensitive(False)
        self.menu.append(self.summary_item)
        for label, callback in (
            ("Open Codex Meter", self.show),
            ("Refresh", lambda *_args: self.refresh()),
        ):
            item = Gtk.MenuItem(label=label)
            item.connect("activate", callback)
            self.menu.append(item)
        self.menu.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", lambda _item: Gtk.main_quit())
        self.menu.append(quit_item)
        self.menu.show_all()
        self.indicator.set_menu(self.menu)

    def show(self, *_args):
        self.window.show_all()
        profile = self.selected_profile()
        self.window.use_account.set_visible(
            bool(profile and profile["id"] != self.store.active_id)
        )
        self.window.present()

    def selected_profile(self):
        return self.store.by_id(self.selected_id)

    def account_selected(self, combo):
        self.selected_id = combo.get_active_id()
        profile = self.selected_profile()
        if profile and self.selected_id in self.snapshots:
            self.window.update_codex(
                profile, self.snapshots[self.selected_id],
                self.selected_id == self.store.active_id,
            )
        self.refresh(provider="codex")

    def refresh(self, provider=None):
        if self.refreshing:
            return
        provider = provider or self.window.stack.get_visible_child_name()
        profile = self.selected_profile()
        if provider == "codex" and not profile:
            self.window.codex_error.set_text("Add a Codex account to begin")
            return
        self.refreshing = True
        self.window.updated.set_text("Reading usage…")
        threading.Thread(
            target=self._fetch, args=(provider, profile), daemon=True
        ).start()

    def _fetch(self, provider, profile):
        try:
            if provider == "cursor":
                data = fetch_cursor(include_activity=True)
            else:
                if profile["id"] == self.store.active_id:
                    self.store.sync_active()
                data = fetch_codex(Path(profile["codexHome"]))
            GLib.idle_add(self._apply, provider, profile, data)
        except Exception as error:
            GLib.idle_add(self._error, provider, str(error))

    def _apply(self, provider, profile, data):
        self.refreshing = False
        if provider == "cursor":
            self.window.update_cursor(data)
        else:
            self.snapshots[profile["id"]] = data
            self.window.update_codex(
                profile, data, profile["id"] == self.store.active_id
            )
            if profile["id"] == self.store.active_id:
                primary = remaining((data.get("rateLimits") or {}).get("primary"))
                self.summary_item.set_label(
                    f"Codex Meter · {primary}% remaining"
                    if primary is not None else "Codex Meter"
                )
                self.indicator.set_label(
                    f" {primary}%" if primary is not None else "", " 100%"
                )
        return False

    def _error(self, provider, message):
        self.refreshing = False
        self.window.updated.set_text("Refresh failed")
        target = (
            self.window.cursor_error if provider == "cursor"
            else self.window.codex_error
        )
        target.set_text(message)
        return False

    def add_account(self):
        if self.refreshing:
            return
        home = ACCOUNTS_DIR / str(uuid.uuid4())
        self.refreshing = True
        self.window.updated.set_text("Waiting for browser sign-in…")
        threading.Thread(target=self._login, args=(home,), daemon=True).start()

    def _login(self, home):
        try:
            data = login_codex(home, lambda url: GLib.idle_add(self._open_login, url))
            GLib.idle_add(self._login_complete, home, data)
        except Exception as error:
            GLib.idle_add(self._error, "codex", str(error))

    def _open_login(self, url):
        webbrowser.open(url)
        return False

    def _login_complete(self, home, data):
        self.refreshing = False
        profile = self.store.add(data, home)
        self.selected_id = profile["id"]
        self.snapshots[profile["id"]] = data
        self.window.load_accounts(self.store.profiles, self.selected_id)
        self.window.update_codex(profile, data, False)
        self.window.updated.set_text("Account added")
        return False

    def use_selected_account(self):
        profile = self.selected_profile()
        if not profile:
            return
        try:
            self.store.switch(profile)
            self.window.use_account.hide()
            self.window.updated.set_text(
                "Account switched · restart Codex terminals to apply"
            )
            self.refresh(provider="codex")
        except Exception as error:
            self.window.codex_error.set_text(str(error))

    def rename_selected(self):
        profile = self.selected_profile()
        if not profile:
            return
        dialog = Gtk.Dialog(title="Rename account", transient_for=self.window, modal=True)
        dialog.add_buttons(
            "Cancel", Gtk.ResponseType.CANCEL, "Rename", Gtk.ResponseType.OK
        )
        entry = Gtk.Entry(text=profile["name"])
        entry.set_activates_default(True)
        dialog.get_content_area().pack_start(entry, True, True, 14)
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            self.store.rename(profile, entry.get_text())
            self.window.load_accounts(self.store.profiles, self.selected_id)
            self.window.codex_name.set_text(profile["name"])
        dialog.destroy()

    def run(self):
        self.window.show_all()
        self.refresh()
        GLib.timeout_add_seconds(REFRESH_SECONDS, self._timer)
        Gtk.main()

    def _timer(self):
        self.refresh(provider="codex")
        return True


if __name__ == "__main__":
    CodexMeterApplication().run()
